segment_*.png
segment_*.t3s

background_*.png
background_*.t3s

console_*.png
console_*.t3s

overlay_*.png
overlay_*.t3s

# The patterns above match by filename anywhere in the tree (meant for
# generated per-game rompack-pipeline output), which would otherwise also
# swallow gfx2x_open_source/ and CONVERT_ROM/david_and_john_patch/assets/ -
# both checked-in David & John art (source, and the standalone patch's own
# bundled copy), not generated output. Re-include them explicitly.
!gfx2x_open_source/**
!CONVERT_ROM/david_and_john_patch/assets/**

romfs/gfx/*
!romfs/gfx/.gitkeep
build/*
!build/.gitkeep
source/std/GW_ROM/*
!source/std/GW_ROM/.gitkeep
source/std/GW_ROM_RGDS/*
!source/std/GW_ROM_RGDS/.gitkeep

CONVERT_ROM/tmp/*
!CONVERT_ROM/tmp/img/.gitkeep
CONVERT_ROM/rom/*
!CONVERT_ROM/rom/.gitkeep
!CONVERT_ROM/rom/default_console.png
CONVERT_ROM/rom/*/.gitkeep
*.pyc

games_path.py
games_path_*.py
# The pattern above is meant only for generated games_path_<target>.py output
# (e.g. games_path_3ds.py, games_path_rgds.py), but it also matches the real,
# checked-in helper module games_path_utils.py by filename prefix - same class
# of accidental-exclusion bug as gfx2x_open_source/ and the david_and_john_patch
# assets earlier. That meant games_path_utils.py was NEVER actually pushed to
# GitHub despite existing locally, breaking convert_original.py for anyone who
# clones fresh (ModuleNotFoundError: source.games_path_utils). Re-include it.
!CONVERT_ROM/source/games_path_utils.py
# add_brick_game.py's backup of the (untracked) games_path_rgds.py.
games_path_*.py.*

# Per-machine tool configuration (copy from CONVERT_ROM/external_apps_template.py)
CONVERT_ROM/external_apps.py

# Dev script outputs
CONVERT_ROM/utils/EXTRACTED_LIST*.md

# Personal scratch/reference material (test photos, MAME romset dumps, old
# pack-manifest output) - never meant for the public repo. Deliberately
# excludes reference/excluded_roms_only/, which holds actual copyrighted
# MAME ROM zips.
reference/

Yokoi*.3dsx
Yokoi*.elf
Yokoi*.nro
Yokoi*.nacp
Yokoi*.cia
Yokoi*.smdh
start_citra_emu.bat

.DS_Store
Thumbs.db   

android/app/build
android/app/captures
android/app/outputs
android/.gradle
android/app/.cxx
android/build
android/app/release
android/app/embedded
android/app/rompackOnly
android/local.properties

switch/build
switch/*.nro
switch/*.nacp
switch/*.elf

*.ykp

# Backups the pack-patching scripts leave next to a pack (e.g. .pre_mfr, .bak).
*.ykp.*
